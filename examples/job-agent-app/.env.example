PORT=8787

# AI provider — pick one (or all). The default provider is read from AI_PROVIDER.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gmail OAuth (Google Cloud Console → OAuth 2.0 Client IDs, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/email/oauth/google/callback

# Outlook OAuth (Azure Portal → App registrations)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:8787/api/email/oauth/microsoft/callback
