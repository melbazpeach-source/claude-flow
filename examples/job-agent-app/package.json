{
  "name": "job-agent-app",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent squad that hunts job listings, rates fit, and drafts custom cover letters.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json",
    "tauri:dev": "cd tauri/src-tauri && cargo tauri dev",
    "tauri:build": "cd tauri/src-tauri && cargo tauri build"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
